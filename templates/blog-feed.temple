<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  {% (def config (args :config)) %}
  {% (def base-url (config :base-url)) %}

  <title>Isaac Freund's Blog</title>
  <link href="{{ base-url }}/blog/"/>
  <link rel="self" href="{{ base-url }}/blog/feed.xml"
    type="application/atom+xml"/>
  <id>{{ base-url }}/blog/feed.xml</id>
  <author>
    <name>{{ (config :author) }}</name>
    <email>{{ (config :email) }}</email>
  </author>

  <updated>{{ (get-in args [:blog-posts 0 :date]) }}T00:00:00Z</updated>

  {$ (import "/templates/feed-entry") $}
  {% (each post (args :blog-posts)
       (feed-entry/render-dict
         (merge post {:url (string/format "%s/blog/%s/"
                                          base-url (post :slug))}))) %}
</feed>
