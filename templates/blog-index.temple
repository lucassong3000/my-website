{% (bagatto/include "/templates/head") %}

{% (bagatto/include "/templates/nav-bar") %}

<main>
  <div class="title row">
    <h1>{{ (get-in args [:_item :title]) }}</h1>
    <div>
      <a href="/blog/feed.xml" type="application/atom+xml">feed.xml</a>
    </div>
  </div>

  <div class="content">
    {% (each post (args :blog-posts)
         (printf
           ```<div class="list-row">
                <time>%s</time>
                <a href="/blog/%s/">%s</a>
              </div>```
           (post :date)
           (post :slug)
           (post :title))) %}
  </div>
</main>

{% (bagatto/include "/templates/foot") %}
