{% (bagatto/include "/templates/head") %}

{% (bagatto/include "/templates/nav-bar") %}

<main>
  <div class="title">
    <h1>{{ (get-in args [:_item :title]) }}</h1>
    {% (if-let [date (get-in args [:_item :date])]
         (printf `<div>
                    <span class="line"><time>%s</time></span>
                    <span class="line">by Isaac Freund</span>
                  </div>` date)) %}
  </div>

  <div class="content">
    {- (match [(get-in args [:_item :type])
               (get-in args [:_item :body])]
         [:poem body] (poem->html body)
         [:markdown body] (bagatto/markdown->html body)
         _ (error (string/format "Unable to render %s"
                    (get-in args [:_item :path])))) -}
  </div>
</main>

{% (bagatto/include "/templates/foot") %}
