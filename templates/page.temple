{% (bagatto/include "/templates/head") %}

{% (bagatto/include "/templates/nav-bar") %}

{% (def item (args :_item)) %}

<main class="{{ (item :slug) }}">
  <div class="title">
    {% (match (item :title)
         "river" (bagatto/include "/templates/river_logo")
         title (printf "<h1>%s</h1>" title)) %}

    {% (if-let [date (item :date)]
         (printf `<div>
                    <span class="line"><time>%s</time></span>
                    <span class="line">by Isaac Freund</span>
                  </div>` date)) %}
  </div>

  <div class="content">
    {- (body->html item) -}
  </div>
</main>

{% (bagatto/include "/templates/foot") %}
