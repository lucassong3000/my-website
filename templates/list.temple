{% (bagatto/include "/templates/head") %}

{% (bagatto/include "/templates/nav-bar") %}

{% (def item (args :_item)) %}

<main>
  <div class="title row">
    <h1>{{ (item :title) }}</h1>
    <a href="/{{ (item :slug) }}/feed.xml" type="application/atom+xml">feed.xml</a>
  </div>

  <div class="content">
    {- (body->html item) -}
    {% (each child (item :children)
         (printf
           `<div class="list-row">
              <time><span class="nowrap">%s</span></time>
              <a href="/%s/%s/">%s</a>
            </div>`
           (child :date)
           (item :slug) (child :slug)
           (child :title))) %}
  </div>
</main>

{% (bagatto/include "/templates/foot") %}
